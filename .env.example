# Path to your local media directory (mounted read-only into containers)
MEDIA_PATH=/mnt/media

# Optional second media source (e.g. an SMB/NFS mount). Mounted read-only at
# /media2 inside the containers; the watcher covers it automatically.
# Leave unset to use a harmless empty default (./sample_media_2).
# MEDIA_PATH_2=/mnt/ipv-ai

# Directory where browser uploads are stored (writable; created automatically)
UPLOAD_PATH=./uploads

# ── IPV Curator integration ───────────────────────────────────────────────────
# Root of Curator's WebProxy tree (e.g. the SMB mount of
# \\server\...\Curator\<SITE>\Proxies\WebProxy). Mounted read-only at /curator.
# When set, ingest reuses Curator's existing H.264 web proxies (matched by the
# proxy folder name = source filename + timestamp) instead of re-encoding —
# no duplicate media. Assets without a matching/playable proxy still encode
# locally as before. The folder index is cached; CURATOR_INDEX_TTL (seconds,
# default 900) controls how often the tree is re-scanned for new proxies.
# Curator's SendToOBTV plug-in writes its small <assets> XML files to one
# dedicated inbox. Mount that writable folder here; OBTV resolves each exact
# WebProxyPath, queues it, then moves the XML under processed/ or failed/.
# Production example:
# CURATOR_INBOX_PATH=/mnt/curator/ObedAI
# CURATOR_PROXY_PATH=/mnt/curator/proxies/WebProxy
# CURATOR_INDEX_TTL=900
# Broad proxy-tree watching is OFF by default. Enable it only for a deliberate
# legacy/backfill run; selected-folder and CURATOR_DIRECT_INGEST behavior then
# work as before.
# CURATOR_LEGACY_FOLDER_WATCH=0
# CURATOR_DIRECT_INGEST=0
# Retry a proxy that is not ready every 120s for up to ~24h.
# CURATOR_XML_RETRY_SECONDS=120
# CURATOR_XML_MAX_RETRIES=720
# Curator's sidecar XMLs carry no hi-res path (it lives in Curator's DB), so
# the hi-res original for NLE exports is reconstructed from the proxy folder
# name (= source basename): <CURATOR_SOURCE_ROOT>\<stem><CURATOR_SOURCE_EXT>.
# CURATOR_SOURCE_ROOT=\\tustopd.trinity.local\ipv\Media
# CURATOR_SOURCE_EXT=.mxf

# Path translation for NLE exports (EDL / FCPXML / OTIO) so Premiere and
# Resolve relink directly to the hi-res originals as the EDIT BAYS see them.
# Semicolon-separated "serverPath=editorPath" pairs; longest prefix wins.
# Windows drive or UNC targets get backslashes automatically.
# EXPORT_PATH_MAP=/media=V:\Media;/media2=\\nas\media2

# Which GPU to use (nvidia-smi index). On a shared box, pin to the GPU
# with the most free VRAM so you don't fight other workloads.
# GPU_DEVICE_ID: primary AI GPU (api Q&A LLM + worker-gpu).
# GPU2_DEVICE_ID: second GPU worker (worker-gpu-2) — pin to the OTHER card so
# GPU jobs (transcribe, diarize, embed, scenes) spread across both GPUs.
GPU_DEVICE_ID=1
GPU2_DEVICE_ID=0

# GPU used for NVENC hardware video encoding (proxy generation).
# IMPORTANT: verify NVENC actually works on the chosen index before pinning it —
# some GPU/driver combos reject encode sessions ("unsupported device (2)") even
# though CUDA works fine on the same card (e.g. RTX 5090 on driver 580.x, while
# an RTX PRO 6000 in the same box encodes fine). Test per index with:
#   docker run --rm --gpus 'device=N' -e NVIDIA_DRIVER_CAPABILITIES=all \
#     -v /path/to/ffmpeg:/f:ro ubuntu:22.04 /f -f lavfi \
#     -i testsrc=duration=1:size=640x360:rate=30 -c:v h264_nvenc -f null -
NVENC_GPU_DEVICE_ID=1

# GPU workers drop their cached models (Qwen LLM, translator, TTS, faces) and
# free CUDA cache after this many seconds with no running task, so ComfyUI and
# other GPU processes get the VRAM back between processing batches. 0 = never.
# Also used by the api service for its Q&A LLM.
GPU_IDLE_RELEASE_SECONDS=300

# Same idea for the api's search embedding models (bge-m3 + SigLIP). Longer
# default because search is latency-sensitive; they reload in ~10-20 s. 0 = never.
EMBED_IDLE_RELEASE_SECONDS=1800

# Whisper model size: tiny, base, small, medium, large-v3
# large-v3 is the most accurate (~3 GB download, ~10 GB VRAM in float16)
WHISPER_MODEL=large-v3

# Local LLM for AI Q&A (any HuggingFace instruction-tuned text-generation model)
# Qwen 3 is UNGATED — no HuggingFace access approval needed. Options:
#   Qwen/Qwen3-4B               (faster, ~9 GB VRAM)
#   Qwen/Qwen3-8B               (default, ~17 GB VRAM)
#   Qwen/Qwen2.5-7B-Instruct    (previous default)
LLM_MODEL=Qwen/Qwen3-8B

# Remote LLM offload — point at any OpenAI-compatible inference server (e.g.
# vLLM on a DGX Spark) and ALL LLM work (AI Q&A, insights, story/reel/social
# prompts) is served there instead of loading the local model on the media
# GPUs. Leave unset for fully local inference (unchanged behavior).
# Example: LLM_BASE_URL=http://192.168.101.1:8000/v1
LLM_BASE_URL=
# Model name to request from the remote server. If unset, the first model the
# server reports at /v1/models is used.
LLM_REMOTE_MODEL=
# Bearer token, only if the remote server requires one.
LLM_API_KEY=

# Sentence embedding model (downloads automatically on first run, ~2.3 GB)
# BAAI/bge-m3 is multilingual and much stronger than MiniLM for retrieval.
# Changing this requires rebuilding the search index (Jobs → Rebuild Search Index).
EMBEDDINGS_MODEL=BAAI/bge-m3

# Vision model for visual scene search (downloads automatically, ~4.5 GB)
# SigLIP-2 so400m substantially beats CLIP ViT-L for text→image retrieval.
# Changing this requires rebuilding the search index (Jobs → Rebuild Search Index).
VISION_MODEL=google/siglip2-so400m-patch14-384

# ── BAGEL inference service ───────────────────────────────────────────────────
# ByteDance-Seed/BAGEL-7B-MoT: unified image understanding + generation model.
# Runs as a dedicated container (worker-bagel) — ideally on the DGX Spark
# (128 GB unified memory) so it doesn't compete with the GPU worker model stack.
# First startup downloads ~30 GB of weights into the bagel_model Docker volume.
#
# GPU index for the worker-bagel container. On the DGX Spark this can be 0
# since the unified memory pool is large enough for BAGEL alongside vLLM.
BAGEL_GPU_DEVICE_ID=0
#
# URL workers use to reach the BAGEL service. Default resolves via Docker
# service name. Override if running BAGEL on a separate host (e.g. DGX Spark):
#   BAGEL_SERVICE_URL=http://192.168.101.1:8003
BAGEL_SERVICE_URL=http://worker-bagel:8003
#
# Per-image caption timeout in seconds (Spark may take several minutes with
# BAGEL offloading). Three consecutive failures stop the batch.
BAGEL_CAPTION_TIMEOUT=600
BAGEL_MAX_CONSECUTIVE_FAILURES=3
# Maximum BAGEL reasoning tokens per frame. Lower values finish batches faster.
BAGEL_CAPTION_MAX_TOKENS=120
#
# Unified-memory GPU total pool size in GiB (GB10 / DGX Spark = 128).
# nvidia-smi reports "Not Supported" for memory.total on GB10, so the server
# uses this value to compute free memory from per-process usage instead.
BAGEL_TOTAL_GPU_MEMORY_GIB=128
#
# Hard cap on how much GPU memory BAGEL may claim (GiB).
# On Spark with vLLM at ~88 GiB leave at least 34 GiB for OS + vLLM growth.
# Unset = auto (nvidia-smi free − 6 GiB headroom).
#BAGEL_MAX_MEMORY_GIB=30

# Translation model: MADLAD-400 3B (default) or facebook/nllb-200-distilled-600M
TRANSLATE_MODEL=google/madlad400-3b-mt

# Speaker diarization pipeline (pyannote.audio 4.x)
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# YouTube publishing (optional). Create an OAuth client (Desktop app) in Google
# Cloud Console with the YouTube Data API v3 enabled, then obtain a refresh
# token for the channel you want to upload to (one-time OAuth consent flow).
# Leave blank to disable the Publish button in the UI.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional: plain API key used for the hourly published-video stats sync
# (views/likes/comments). Falls back to the OAuth trio above if unset.
# Also used by the trends worker to pull the YouTube trending chart.
YOUTUBE_API_KEY=

# External trends (Insights page → "Trending Now"). SEARXNG_URL points at the
# bundled searxng container by default — no key needed; only library topic
# keywords are sent as search queries. TRENDS_REGION picks the YouTube
# trending chart region (ISO 3166 country code).
SEARXNG_URL=http://searxng:8080
TRENDS_REGION=US

# Socials page (per-program channel growth + per-post metrics, synced every
# 6 h or via the Refresh button). YouTube reuses YOUTUBE_API_KEY above.
# META_ACCESS_TOKEN: a Meta Graph API token (system user token recommended);
# META_IG_USER_ID: the IG business account id tied to that token — required
# for Instagram business_discovery lookups of public accounts.
# TIKTOK_ACCESS_TOKEN: reserved; TikTok channels show "not configured" until wired.
META_ACCESS_TOKEN=
META_IG_USER_ID=
TIKTOK_ACCESS_TOKEN=

# Web face search (person page → "Web Face Search"). Reverse-searches a
# person's face via Google Lens using SerpAPI (https://serpapi.com — free tier
# is 100 searches/month). The face thumbnail is uploaded to a 1-hour temporary
# public host (litterbox.catbox.moe) so Google can fetch it; runs only on
# explicit user request. Leave empty to disable.
SERPAPI_KEY=

# HuggingFace token — required for pyannote.audio speaker diarization
# (instant approval: accept terms at https://hf.co/pyannote/speaker-diarization-community-1)
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Cloned-voice dubbing engine: "chatterbox" (default, more natural) or "xtts".
# Chatterbox falls back to XTTS-v2 automatically if it fails to load.
DUB_ENGINE=chatterbox

# Keep the original background audio (music/ambience) under dubbed speech.
# Demucs (bundled with torchaudio) separates vocals from the rest; only the
# non-vocal part is mixed back in. Set to 0 to dub speech-only as before.
DUB_KEEP_BACKGROUND=1
# Volume of the preserved background relative to the original (0.0-1.0+).
DUB_BG_GAIN=0.9

# Lip sync (optional per-dub toggle in the UI). Wav2Lip-GAN weights download
# from HuggingFace on first use (~400 MB). Override the source repo/file, or
# point to a local .pth to skip the download entirely.
#LIPSYNC_MODEL_REPO=camenduru/Wav2Lip
#LIPSYNC_MODEL_FILE=checkpoints/wav2lip_gan.pth
#LIPSYNC_MODEL_PATH=/models/wav2lip_gan.pth

# ── Graphics generator (ComfyUI) ──────────────────────────────────────────────
# URL of your existing ComfyUI install, as seen FROM INSIDE the containers.
# host.docker.internal resolves to the Docker host — ComfyUI must listen on
# 0.0.0.0 (start it with --listen) or at least on the docker bridge.
COMFYUI_URL=http://host.docker.internal:8188
# Running two ComfyUI instances (one for images, one for video)? Point each
# kind at its own instance; anything unset falls back to COMFYUI_URL.
# COMFYUI_URL_IMAGE=http://host.docker.internal:8188
# COMFYUI_URL_VIDEO=http://host.docker.internal:8189
# Host folder with custom ComfyUI workflow JSONs ("Export (API format)").
# Each file appears as an extra preset on the Graphics page.
COMFY_WORKFLOWS_PATH=./comfy_workflows

# ── User accounts & login ─────────────────────────────────────────────────────
# First-run admin account (created only when the users table is empty).
# If ADMIN_PASSWORD is left empty a random password is generated and printed
# ONCE in the api container log: docker compose logs api | grep -A3 ADMIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Shared secret so the file watcher can call the API without a login session.
# REQUIRED — watched-folder ingest stops working without it. Generate one:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=

# ── Ratings ───────────────────────────────────────────────────────────────────
# Comma-separated call letters of YOUR stations. Ratings rows for these are
# shown as "own" (KPIs, trend, top programs); everything else is competitive.
# Computed at read time — changing this never requires re-importing data.
OWN_STATIONS=OBTV,OBTV2
