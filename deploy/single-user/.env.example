# This file configures ONLY deploy/single-user/docker-compose.yml.
# Copy it to deploy/single-user/.env and never commit the populated file.
OBTV_SINGLE_HTTP_PORT=5500

# Use a URL-safe database password or URL-encode it in both database URLs.
OBTV_SINGLE_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_ALPHANUMERIC

OBTV_SINGLE_ADMIN_USERNAME=admin
OBTV_SINGLE_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
OBTV_SINGLE_INTERNAL_API_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN

# Host directories. WebProxy and HiRes are mounted read-only by Compose.
OBTV_SINGLE_CURATOR_PROXY_PATH=/srv/obtv-single/mounts/curator-webproxy
OBTV_SINGLE_CURATOR_HIRES_PATH=/srv/obtv-single/mounts/curator-hires
OBTV_SINGLE_IMPORTS_PATH=/srv/obtv-single/imports
OBTV_SINGLE_UPLOAD_PATH=/srv/obtv-single/uploads

# Curator client-credentials OAuth. Use the secret VALUE, not its secret ID.
OBTV_SINGLE_CURATOR_API_BASE_URL=https://curator.tbn.tv/CuratorGateway
OBTV_SINGLE_CURATOR_CLIENT_ID=
OBTV_SINGLE_CURATOR_CLIENT_SECRET=
# The supplied Postman request does not send scope. Leave blank unless required.
OBTV_SINGLE_CURATOR_OAUTH_SCOPE=

# Required: the canonical Curator metadata field whose value exactly equals
# each spreadsheet Media ID. Confirm this field with a one-row API lookup.
OBTV_SINGLE_CURATOR_MEDIA_ID_QUERY_FIELD=CHANGE_ME_CANONICAL_FIELD
OBTV_SINGLE_CURATOR_WEB_PROXY_FIELDS=WebProxyPath,Web Proxy Path,ProxyPath
OBTV_SINGLE_CURATOR_HIRES_FIELDS=HiResPath,Hi Res Path,FilePath

# Only used when a Curator asset lacks WebProxyPath and HiResPath is used.
# This is the external path represented by CURATOR_HIRES_PATH inside /media.
# Example syntax: \\server\share\Media
OBTV_SINGLE_CURATOR_HIRES_UNC_PREFIX=

# One L4: conservative defaults. Increase Florence batch size only after a
# successful full-pipeline smoke test.
OBTV_SINGLE_FLORENCE_CAPTION_BATCH_SIZE=1
OBTV_SINGLE_GPU_IDLE_RELEASE_SECONDS=180
OBTV_SINGLE_EMBED_IDLE_RELEASE_SECONDS=300
OBTV_SINGLE_WHISPER_MODEL=large-v3
OBTV_SINGLE_LLM_MODEL=Qwen/Qwen3-4B
OBTV_SINGLE_HF_TOKEN=